{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Exile Command HUD",
  "version": "0.9.4",
  "identifier": "com.goexile.command.hud",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Exile Command HUD",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http: https: ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Exile Operations",
    "copyright": "© 2026 Exile Operations",
    "category": "Utility",
    "shortDescription": "High-performance command and control interface for the Exile network.",
    "longDescription": "Exile Command HUD provides administrators with a high-density, real-time tactical overview of game server infrastructure, node health, and player sessions."
  },
  "plugins": {
    "notification": null,
    "log": null,
    "shell": null,
    "process": null
  }
}
