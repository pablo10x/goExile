# -----------------------------------------------------------------------------
# Master Server Connection
# -----------------------------------------------------------------------------
# URL of the Master Server (Registry)
MASTER_URL=http://localhost:8081

# API Key for authenticating with the Master Server.
# Must match MASTER_API_KEY in server/.env
MASTER_API_KEY=your_very_secret_master_api_key_here

# -----------------------------------------------------------------------------
# Node Identification & Config
# -----------------------------------------------------------------------------
# Region identifier (e.g. US-East).
# Required if enrolling via CLI flags, otherwise managed by Master.
REGION=US-East

# Directory where game server instances will be spawned
INSTANCES_DIR=./instances

# Operational State
# Set to 'true' to prevent new instances from spawning (Maintenance Mode)
IS_DRAINING=false

# -----------------------------------------------------------------------------
# Game Server Source
# -----------------------------------------------------------------------------
# Path to the game server binary relative to the install directory
# e.g. "server.x86_64" or "MyGame.exe"
GAME_BINARY_PATH=server.x86_64

# Directory where the game server binary is installed (source template for instances)
GAME_INSTALL_DIR=./game_server

# Download Token (Optional)
# Token required if downloading game server files from a protected source
GAME_DOWNLOAD_TOKEN=

# -----------------------------------------------------------------------------
# Advanced Configuration (Optional)
# -----------------------------------------------------------------------------
# Comma-separated tags for this node (e.g. "gpu,high-cpu")
TAGS=

# Maintenance window schedule (e.g. "Mon 03:00-04:00")
MAINTENANCE_WINDOW=

# JSON string defining resource limits (e.g. {"cpu": 2.0, "memory": 4096})
RESOURCE_LIMITS=

# Public IP override (if behind NAT and auto-detection fails)
PUBLIC_IP=